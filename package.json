{
  "name": "speakflow-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SpeakFlow AI - real-time communication copilot with provisional and refined reply scripts",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/bench-pipeline.mjs",
    "bench:local": "tsx scripts/bench-local-pipeline.mjs",
    "bench:stt": "tsx scripts/bench-stt-transport.mjs",
    "bench:models": "tsx scripts/bench-models.mjs",
    "test:e2e": "npm run build && node scripts/e2e-browser.mjs",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "check:extension": "node scripts/check-extension.mjs",
    "package:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:bundle && npm run check:extension",
    "verify:full": "npm run verify && node scripts/e2e-browser.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
