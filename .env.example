# =============================================================================
# SpeakFlow AI - environment template. Copy to `.env` and fill in real values.
# NEVER commit `.env`. The browser bundle must never contain a provider key.
# =============================================================================

# --- Server -----------------------------------------------------------------
# Port the Express API listens on (Vite proxies /api here in development).
PORT=8787
NODE_ENV=development

# Comma-separated list of origins allowed to call the API with credentials.
# Development default matches the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OpenAI -----------------------------------------------------------------
# Server-side only. If this is empty the API reports "aiConfigured: false" and
# every AI endpoint returns 503 PROVIDER_NOT_CONFIGURED. Nothing is faked.
OPENAI_API_KEY=

# Optional override for self-hosted / Azure-compatible gateways.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model used for provisional/refined reply generation and translation.
# gpt-4o-mini is cheap and fast; any model that supports Structured Outputs works.
OPENAI_REPLY_MODEL=gpt-4o-mini

# Model used for live streaming transcription over the Realtime API.
# Supported values include: gpt-4o-transcribe, gpt-4o-mini-transcribe.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Language hint for transcription (ISO-639-1). SpeakFlow listens to English.
OPENAI_TRANSCRIBE_LANGUAGE=en

# Server VAD silence duration (ms) before OpenAI finalises an utterance.
# Lower = faster refined replies, higher = fewer mid-sentence cuts. 200-600 sensible.
REALTIME_SILENCE_MS=320

# Seconds the browser-held ephemeral realtime token stays valid.
REALTIME_TOKEN_TTL_SECONDS=600

# --- Reply model provider (pick a free path) --------------------------------
# openai               paid, provider-enforced Structured Outputs (json_schema)
# groq                free tier for open-weight models (json_object)
# openai-compatible   any OpenAI-compatible endpoint
# local               Ollama / LM Studio on THIS machine. No key needed.
#                     See docs/LOCAL_MODEL.md before choosing this.
AI_PROVIDER=openai
# Key for the chosen reply provider. Ignored (and unnecessary) for `local`.
AI_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=http://127.0.0.1:11434/v1
# Hard cap on AI requests per server day. 0 disables the cap.
AI_DAILY_REQUEST_BUDGET=200

# Answer provisional (mid-sentence) replies from the local response library.
# Costs nothing and fires in microseconds. Set to 0 to force every reply through
# the model. See docs/BENCHMARKS.md for measured timings.
AI_FAST_PATH=1
# Max wait before a provisional reply is forced even if the speaker never pauses.
# Without this, a talker who does not stop produces no suggestion at all.
PROVISIONAL_MAX_WAIT_MS=1800

# --- Speech-to-text ---------------------------------------------------------
# openai-realtime      true streaming over WebRTC. OpenAI only, paid, real partials.
# openai-compatible    chunked HTTP upload. Works on free tiers. NO partials; text
#                     arrives per chunk (1.5-3 s behind the speaker).
# whisper-cpp          FULLY LOCAL and fully free: open-source Whisper on this
#                     machine. No key, no quota, no audio leaving the device.
#                     One-time download: see docs/LOCAL_STT.md
# See docs/STT_PROVIDERS.md for the difference before switching.
STT_PROVIDER=openai-realtime
# whisper.cpp paths (only read when STT_PROVIDER=whisper-cpp).
# WHISPER_CPP_BIN=.local-models/Release/whisper-cli.exe
# WHISPER_CPP_MODEL=.local-models/ggml-base.en.bin
# Transport for the local recogniser:
#   cli     one whisper-cli process per chunk. Simplest; ~0.9 s of process
#           startup paid per chunk (measured, docs/BENCHMARKS.md).
#   server  talks to an already-running whisper-server that keeps the model in
#           memory. You start it yourself - SpeakFlow never launches it.
# WHISPER_CPP_MODE=cli
# WHISPER_CPP_SERVER_URL=http://127.0.0.1:8080
# WHISPER_CPP_SERVER_BIN=.local-models/Release/whisper-server.exe
# Key for the chunked route. Does NOT fall back to OPENAI_API_KEY for a
# non-OpenAI host, because that would fail auth at request time.
STT_API_KEY=
# GROQ_API_KEY is also accepted as a source for STT_API_KEY.
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
# Target chunk length, and the trailing quiet that closes a chunk early.
STT_CHUNK_MS=2400
STT_SILENCE_MS=420
# Hard cap on chunks per call, so a stuck retry loop cannot drain a free tier.
STT_MAX_REQUESTS_PER_SESSION=240

# --- Behaviour / limits -----------------------------------------------------
# Hard cap on transcript characters sent to the model (cost + abuse guard).
MAX_TRANSCRIPT_CHARS=4000
# Recent finalized utterances kept as conversation context.
CONTEXT_WINDOW_TURNS=6
# How long an unused call session (and its in-memory transcript) is retained.
SESSION_TTL_MINUTES=120
# Upstream OpenAI request timeout in ms.
AI_REQUEST_TIMEOUT_MS=20000

# --- Security ---------------------------------------------------------------
# Optional shared access token. When set, every /api route except /api/health
# and /api/config requires `Authorization: Bearer <token>`.
# This is a single-workspace gate, NOT multi-user auth. See README.
APP_ACCESS_TOKEN=

# Per-IP rate limits (requests per window).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# AI endpoints are far more expensive, so they get their own tighter bucket.
AI_RATE_LIMIT_MAX=40

# --- Development helpers ----------------------------------------------------
# Force the deterministic mock AI provider (no network calls, no key needed).
# Mocked responses are clearly labelled "MOCK" in the UI. Use for tests/UI work.
MOCK_AI=0

# Persist saved vocabulary to a local JSON file (single-workspace mode only).
ENABLE_VOCAB_PERSISTENCE=0
VOCAB_FILE=.data/vocabulary.json

# --- Session storage (required for any multi-instance host) ------------------
# Unset: call-session metadata lives in this process's memory, which is correct
# for `npm run dev` and the test suite. Set it to move sessions into Postgres,
# which a serverless host needs: a session created by one instance must be
# visible to the next, or the first audio chunk answers SESSION_NOT_FOUND.
# The table is created on first use; there is no migration step.
# See docs/DEPLOYMENT.md.
DATABASE_URL=
DATABASE_POOL_MAX=3
# Defaults to on for any non-loopback host. An sslmode in the URL wins.
DATABASE_SSL=

# --- Frontend (build time, exposed to the browser) --------------------------
# Absolute API base for a SPLIT deployment (SPA on Vercel, API on Render).
# Leave unset for a single-service deployment where the API serves the SPA.
# Example: VITE_API_BASE_URL=https://speakflow-api.onrender.com/api
VITE_API_BASE_URL=

# Only the workspace access token is ever exposed, and only if you use one.
# VITE_APP_ACCESS_TOKEN=
