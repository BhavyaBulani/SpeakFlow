node_modules/
dist/
build/
coverage/

# Local environment files - never commit real credentials
.env
.env.local
.env.*.local
!.env.example

# Ad hoc scratch files holding pasted credentials (a key copied out of a
# provider dashboard). `.env` is the one file dotenv reads; these are
# throwaway, easy to forget, and were nearly committed once.
env*.txt
*.env.txt

# Local runtime data (vocabulary persistence, logs)
.data/
*.log
npm-debug.log*
logs/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.tsbuildinfo

# Local tooling artefacts
openai-openapi.yaml
speakflow-extension.zip
.e2e-*.png
.*.log
.e2e-extension-profile/

# Scratch prompt / planning notes - never part of the app or its history
master_prompt.txt
prompt_*.txt

# Session handoff notes - local working state, not part of the product.
# COVEXCODE.md is deliberately NOT here: shipped docs link to it.
PROGRESS.md
NEXT_STEPS.md

# Local whisper.cpp installs: hundreds of MB of binaries and models.
# Recreated from docs/LOCAL_STT.md - never committed.
.local-models/

# Throwaway GitHub API responses written while inspecting whisper.cpp releases
.assets.txt
.rel*.json

# Local scratch output from verification runs
.verify*.log
bench-*.log
